COMPOSE_PROJECT_NAME=vufind-bulk-downloader

# Public HTTP port for the bulk downloader service.
BULK_DOWNLOADER_PORT=8081

# Java memory options for the bulk-downloader container
JAVA_OPTS=-Xms256m -Xmx2g

# Application properties defaults used to generate src/main/resources/application.properties
# Override any value below in your .env before running the helper script.

APP_SOLR_SERVER_URL=http://172.16.17.42:8080/solr/biblio
APP_FILE_PATH=/app/data/
APP_FILE_SEP_CHAR=,
APP_FILE_LIST_SEP=||
APP_FILE_HEADER='{"title":"T\u00edtulo do documento","publishDate":"Ano de publica\u00e7\u00e3o","author":"Autores","instname_str":"T\u00edtulo da institui\u00e7\u00e3o fonte","institution":"Sigla da institui\u00e7\u00e3o fonte","format":"Tipo de documento","dc.identifier.citation.fl_str_mv":"Refer\u00eancia"}'
APP_FILE_AGG_FIELDS='{"Orientadores":"dc.contributor.advisor1.fl_str_mv,dc.contributor.advisor2.fl_str_mv","ID Lattes dos orientadores":"dc.contributor.advisor1Lattes.fl_str_mv,dc.contributor.advisor2Lattes.fl_str_mv","Membros da banca":"dc.contributor.referee1.fl_str_mv,dc.contributor.referee2.fl_str_mv,dc.contributor.referee3.fl_str_mv,dc.contributor.referee4.fl_str_mv,dc.contributor.referee5.fl_str_mv","ID Lattes dos membros da banca":"dc.contributor.referee1Lattes.fl_str_mv,dc.contributor.referee2Lattes.fl_str_mv,dc.contributor.referee3Lattes.fl_str_mv,dc.contributor.referee4Lattes.fl_str_mv,dc.contributor.referee5Lattes.fl_str_mv"}'
APP_FILE_NULL_MSG=N\u00e3o informado pela institui\u00e7\u00e3o
APP_FILE_NO_MSG_FIELDS=dc.contributor.co.fl_str_mv
APP_MAIL_HOST=smtp.gmail.com
APP_MAIL_PORT=587
APP_MAIL_USERNAME=email@gmail.com
APP_MAIL_PASSWORD=password
APP_MAIL_SMTP_AUTH=true
APP_MAIL_SMTP_STARTTLS_ENABLE=true
APP_MAIL_CONFIRM_SUBJECT=Exporta\u00e7\u00e3o de busca no [AppName]
APP_MAIL_READY_MSG=Prezado usu\u00e1rio,<br><br>Seu arquivo CSV foi criado com \u00eaxito.<br><br>Atenciosamente,<br>Equipe [AppName].
APP_MAIL_WAIT_MSG_TOP=Prezado usu\u00e1rio,<br><br>Sua solicita\u00e7\u00e3o de exporta\u00e7\u00e3o foi recebida e o arquivo CSV est\u00e1 sendo criado. Devido \u00e0 quantidade de registros, o arquivo dever\u00e1 levar alguns minutos para ficar pronto. Voc\u00ea receber\u00e1 outro e-mail com o link para download quando estiver conclu\u00eddo.<br><br>Atenciosamente,<br>Equipe [AppName].
APP_MAIL_WAIT_MG_BOTTOM=para ficar pronto. Voc\u00ea receber\u00e1 outro e-mail com o link para download quando estiver conclu\u00eddo.<br><br>Atenciosamente,<br>Equipe [AppName].
APP_MAIL_LINK_SUBJECT=Download do arquivo CSV
APP_MAIL_LINK_MSG_TOP=Prezado usu\u00e1rio,<br><br>Seu arquivo CSV est\u00e1 pronto e pode ser baixado atrav\u00e9s do link
APP_MAIL_LINK_MSG_BOTTOM=<br><br>O arquivo ficar\u00e1 dispon\u00edvel para download por 24 horas.<br><br>Atenciosamente,<br>Equipe [AppName].
APP_TIME_SHORT_RECORD=1.4
APP_TIME_LONG_RECORD=2.8
APP_TIME_SERVER_DELAY=1.5
APP_TIME_UNITS='{"day":"dia(s)","hour":"hora(s)","minute":"minuto(s)","conjunction":"e"}'
APP_SERVER_HOST=http://localhost
APP_SERVER_PORT=8081
APP_FILE_RIS='{"ty":"format","au":"author_facet","py":"publishDate","ti":"title","la":"dc.language.iso.fl_str_mv","ab":"description","di":"identifier_str_mv","ur":"dc.identifier.uri.fl_str_mv","jo":"reponame_str","issn":"dc.identifier.issn.pt_BR.fl_str_mv","isbn":"dc.identifier.isbn.pt_BR.fl_str_mv","k1":"topic"}'
